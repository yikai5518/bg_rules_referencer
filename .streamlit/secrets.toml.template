# Streamlit Google OpenID Connect (OIDC) Authentication Configuration
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to `.streamlit/secrets.toml`:
#    cp .streamlit/secrets.toml.template .streamlit/secrets.toml
#
# 2. In Google Cloud Console (https://console.cloud.google.com/apis/credentials):
#    - Create an OAuth 2.0 Web Application client
#    - Add Authorized Redirect URI: http://localhost:8501/oauth2callback
#      (If deployed to production, also add: https://<your-domain>/oauth2callback)
#
# 3. Fill in your client_id and client_secret below.
#
# 4. Generate a cookie_secret:
#    uv run python -c "import secrets; print(secrets.token_hex(32))"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "CHANGE_ME_TO_A_RANDOM_SECRET_KEY" # pragma: allowlist secret
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET" # pragma: allowlist secret
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Primary administrator email (required). This user can add/remove users from the in-app whitelist.
admin_email = "your.email@gmail.com"

# Optional baseline allowed emails. Additional users can also be added directly in the app.
allowed_emails = [
    "your.email@gmail.com",
]
